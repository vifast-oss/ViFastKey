{
  "input_method": "telex",
  "tone_style": "new",
  "spell_check": true,
  "w_as_u": true,
  "bracket_keys": false,
  "quick_telex": false,
  "allow_coda_k": false,
  "auto_restore_english": true,
  "macro_enabled": true,
  "macro_digits": false,
  "macro_undo": true,
  "macro_in_off_mode": false,
  "macros": {
    "ko": "không",
    "vn": "Việt Nam",
    "dc": "được"
  },
  "auto_capitalize": false,
  "excluded_apps": ["minecraft"],
  "app_modes": {},
