[Unit]
Description=ViFastKey Wayland input method
Documentation=https://github.com/vifast-oss/ViFastKey
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vifastkey-wayland
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
