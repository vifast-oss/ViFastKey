version: 2
updates:
  - package-ecosystem: cargo
    directory: /rust
    schedule:
      interval: weekly
      day: monday
    open-pull-requests-limit: 5
    groups:
      rust-dependencies:
        patterns: ["*"]
  - package-ecosystem: pip
    directory: /python
    schedule:
      interval: weekly
      day: monday
    open-pull-requests-limit: 3
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
      day: monday
    open-pull-requests-limit: 3
    ignore:
      # gradle/actions v6 đưa caching sang component thương mại riêng.
      - dependency-name: "gradle/actions/setup-gradle"
        update-types: ["version-update:semver-major"]
      - dependency-name: "gradle/actions"
        update-types: ["version-update:semver-major"]
